[gd_scene format=3 uid="uid://dlo8hd654xwpo"]

[sub_resource type="GDScript" id="GDScript_vqg1w"]
script/source = "extends CanvasLayer

signal reset_requested

@onready var activation_url: LineEdit = $Panel/MarginContainer/VBoxContainer/ActivationUrl
@onready var user_code: Label = $Panel/MarginContainer/VBoxContainer/UserCode
@onready var status_label: Label = $Panel/MarginContainer/VBoxContainer/StatusLabel


func _ready() -> void:
	$Panel/MarginContainer/VBoxContainer/CopyUrlButton.pressed.connect(_copy_activation_url)
	$Panel/MarginContainer/VBoxContainer/ResetButton.pressed.connect(_on_reset_pressed)


func show_authorization(verification_uri: String, code: String) -> void:
	activation_url.text = verification_uri
	user_code.text = \"Activation code: %s\" % code
	status_label.text = \"Waiting for Twitch approval\"


func set_status(status: String) -> void:
	status_label.text = status


func _copy_activation_url() -> void:
	DisplayServer.clipboard_set(activation_url.text)
	status_label.text = \"Activation URL copied to clipboard\"


func _on_reset_pressed() -> void:
	reset_requested.emit()
"

